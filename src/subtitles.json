{
  "s00": [
    {
      "start": 0,
      "end": 4.02,
      "text": "今天讲图工程，把一堆关系画成图让电脑照着跑。"
    },
    {
      "start": 4.02,
      "end": 6.76,
      "text": "五件事：什么是图、为啥需要图、"
    },
    {
      "start": 6.76,
      "end": 10.24,
      "text": "Agent 怎么用图、三维框架怎么看，"
    },
    {
      "start": 10.24,
      "end": 11.88,
      "text": "最后看个真实项目。"
    }
  ],
  "s01": [
    {
      "start": 0,
      "end": 4.06,
      "text": "图就是点和线。公司架构是图，地铁线路是图，"
    },
    {
      "start": 4.06,
      "end": 8.12,
      "text": "家族族谱也是图。它们不看单个东西长什么样，"
    },
    {
      "start": 8.12,
      "end": 11.21,
      "text": "只看连不连得上、怎么连、连多远。"
    }
  ],
  "s02": [
    {
      "start": 0,
      "end": 4.21,
      "text": "HR 系统能告诉你有多少人、各在什么部门。"
    },
    {
      "start": 4.21,
      "end": 7.82,
      "text": "但张三请假谁能顶？顶的人又请假了？表"
    },
    {
      "start": 7.82,
      "end": 11.83,
      "text": "格答不上来。要查二度人脉、故障怎么扩散、"
    },
    {
      "start": 11.83,
      "end": 14.23,
      "text": "任务能不能回退，得用图。"
    }
  ],
  "s03": [
    {
      "start": 0,
      "end": 3.61,
      "text": "数据图工程分六层。最底下是点和边的定义，"
    },
    {
      "start": 3.61,
      "end": 4.69,
      "text": "往上是建模，"
    },
    {
      "start": 4.69,
      "end": 8.66,
      "text": "再往上是 Neo4j 这种专门存图的数据库，"
    },
    {
      "start": 8.66,
      "end": 11.55,
      "text": "然后是 Cypher 查询语言。"
    },
    {
      "start": 11.55,
      "end": 15.34,
      "text": "再往上是图神经网络，最后落到反欺诈、推荐、"
    },
    {
      "start": 15.34,
      "end": 18.41,
      "text": "知识图谱。从结构到智能，逐层递进。"
    }
  ],
  "s04": [
    {
      "start": 0,
      "end": 3.3,
      "text": "Agent 图工程是把多 Agent"
    },
    {
      "start": 3.3,
      "end": 7.15,
      "text": " 系统画成一张显式图。节点是 Agent，"
    },
    {
      "start": 7.15,
      "end": 9.35,
      "text": "边是路由，状态沿边流动。"
    },
    {
      "start": 9.35,
      "end": 13.01,
      "text": "四个原语记住就行：节点、边、状态、引擎。"
    },
    {
      "start": 13.01,
      "end": 15.58,
      "text": "图是执行引擎，也是真相来源。"
    }
  ],
  "s05": [
    {
      "start": 0,
      "end": 2.85,
      "text": "图工程真正让人乱的不是有几个流派，"
    },
    {
      "start": 2.85,
      "end": 5.37,
      "text": "而是每个人说的图暗含三个维度。"
    },
    {
      "start": 5.37,
      "end": 8.72,
      "text": "Scope 是范围，Plane 是视角，"
    },
    {
      "start": 8.72,
      "end": 11.24,
      "text": "Dynamism 是动态程度。"
    },
    {
      "start": 11.24,
      "end": 12.75,
      "text": "记住这把三维尺子，"
    },
    {
      "start": 12.75,
      "end": 15.26,
      "text": "每次遇到图工程先问这三个问题。"
    }
  ],
  "s06": [
    {
      "start": 0,
      "end": 1.62,
      "text": "Scope 分两种图。"
    },
    {
      "start": 1.62,
      "end": 4.27,
      "text": "左边 Work Graph 是项目执"
    },
    {
      "start": 4.27,
      "end": 5.6,
      "text": "行计划：用完就扔。"
    },
    {
      "start": 5.6,
      "end": 8.25,
      "text": "右边 Org Graph 是组织架构"
    },
    {
      "start": 8.25,
      "end": 11.49,
      "text": "：长期存在。两种图不是大小关系，是语义不同。"
    },
    {
      "start": 11.49,
      "end": 14.14,
      "text": "中间靠 Assignment 桥接。"
    }
  ],
  "s07": [
    {
      "start": 0,
      "end": 2.43,
      "text": "Plane 分五个平面。"
    },
    {
      "start": 2.43,
      "end": 6.7,
      "text": "控制平面指挥谁先做谁后做。执行平面真干活。"
    },
    {
      "start": 6.7,
      "end": 10.75,
      "text": "评价平面做验收。自适应平面根据反馈学习。"
    },
    {
      "start": 10.75,
      "end": 12.38,
      "text": "治理平面定边界。"
    },
    {
      "start": 12.38,
      "end": 16.03,
      "text": "一条铁律：干活的人和质量检查的人绝不"
    },
    {
      "start": 16.03,
      "end": 17.45,
      "text": "能是同一个人。"
    }
  ],
  "s08": [
    {
      "start": 0,
      "end": 4.11,
      "text": "Dynamism 分四级。静态图流程固定，"
    },
    {
      "start": 4.11,
      "end": 7.43,
      "text": "适合创业初期。条件图能按情况分流。"
    },
    {
      "start": 7.43,
      "end": 9.97,
      "text": "运行时生成图能当场拆任务。"
    },
    {
      "start": 9.97,
      "end": 12.12,
      "text": "自适应图能自动改流程。"
    },
    {
      "start": 12.12,
      "end": 15.64,
      "text": "动态性不是图工程的必要条件——静态流"
    },
    {
      "start": 15.64,
      "end": 17.21,
      "text": "程图也是图工程。"
    }
  ],
  "s09": [
    {
      "start": 0,
      "end": 4.11,
      "text": "把三维坐标里一格展开，就是理想参考架构。"
    },
    {
      "start": 4.11,
      "end": 8.64,
      "text": "先看定位，再讲原则，再选拓扑——线性、扇形、"
    },
    {
      "start": 8.64,
      "end": 13.36,
      "text": "菱形还是网状。然后用原语拼装：节点、边、状态、"
    },
    {
      "start": 13.36,
      "end": 18.09,
      "text": "记忆、路由、检查器。三个最该记：路由决定流向，"
    },
    {
      "start": 18.09,
      "end": 19.94,
      "text": "检查器是质量闸门。"
    }
  ],
  "s10": [
    {
      "start": 0,
      "end": 3.38,
      "text": "Scope 乘 Plane 是个矩阵。"
    },
    {
      "start": 3.38,
      "end": 7.47,
      "text": "节点这一层看怎么完成任务、判断完成、改提示词。"
    },
    {
      "start": 7.47,
      "end": 10.84,
      "text": "Work 这一层看任务依赖、阶段验收、"
    },
    {
      "start": 10.84,
      "end": 14.22,
      "text": "动态增删。Org 这一层看多团队协作、"
    },
    {
      "start": 14.22,
      "end": 17.95,
      "text": "部门评估、角色增减。每个交叉点都是真问题。"
    }
  ],
  "s11": [
    {
      "start": 0,
      "end": 2.72,
      "text": "看个真实案例：CodexLoom。"
    },
    {
      "start": 2.72,
      "end": 6.39,
      "text": "Scope 上只做组织架构这一层，不碰项目层。"
    },
    {
      "start": 6.39,
      "end": 8.63,
      "text": "Plane 上执行和治理强，"
    },
    {
      "start": 8.63,
      "end": 10.22,
      "text": "评价和自适应是短板。"
    },
    {
      "start": 10.22,
      "end": 12.62,
      "text": "Dynamism 只做静态图。"
    },
    {
      "start": 12.62,
      "end": 15.34,
      "text": "知道自己不做什么，比做什么更重要。"
    }
  ],
  "s12": [
    {
      "start": 0,
      "end": 1.16,
      "text": "带走三句话。"
    },
    {
      "start": 1.16,
      "end": 4.65,
      "text": "先让员工的个人循环跑稳再谈图——跑不"
    },
    {
      "start": 4.65,
      "end": 6.59,
      "text": "稳上图只会制造混乱。"
    },
    {
      "start": 6.59,
      "end": 10.08,
      "text": "检查器是瓶颈——干活的人和质量检查的"
    },
    {
      "start": 10.08,
      "end": 11.83,
      "text": "人不能是同一个人。"
    },
    {
      "start": 11.83,
      "end": 15.32,
      "text": "会判断不用图比会画图更高级——不是所"
    },
    {
      "start": 15.32,
      "end": 16.87,
      "text": "有协作都该建模。"
    }
  ]
}